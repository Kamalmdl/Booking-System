# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.

# PostgreSQL password used by all databases (docker-compose) and services
DB_PASSWORD=change_me

# Secret key used to sign/verify JWT tokens.
# Must be identical across user-service, hotel-service and booking-service.
# Generate a strong random value, e.g.: openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_string
